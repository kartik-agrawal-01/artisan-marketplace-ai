# Copy this file to backend/.env and fill in your own values.
# Never commit .env or a service-account key file.

# Set to 1 to run without Google Cloud: every service is replaced by an in-memory fake.
ARTISAN_FAKE_CLOUD=0

PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
BUCKET_NAME=your-gcs-bucket-name

# Local runs only: path to a service-account key. On Cloud Run leave it unset;
# the service's own credentials are used.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
